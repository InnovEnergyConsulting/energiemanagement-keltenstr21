# EMS – einziger Web-Einstieg, HTTPS mit eigener LAN-Zertifizierungsstelle (tls internal).
# Stammzertifikat für Browser/Handy: data/caddy/caddy/pki/authorities/local/root.crt
{
	admin off
	skip_install_trust
	# Aufruf per IP sendet kein SNI -> ohne Vorgabe findet Caddy kein Zertifikat (TLS internal error)
	default_sni 192.168.0.172
	# Wer "192.168.0.172:8443" ohne https:// eintippt (Handy!), schickt HTTP an den HTTPS-Port ->
	# statt Fehlermeldung automatisch auf https umleiten (gilt für 8443 und 8444)
	servers {
		listener_wrappers {
			http_redirect
			tls
		}
	}
}

https://192.168.0.172:8443 {
	tls internal

	redir / /grafana/ 302

	handle /grafana* {
		reverse_proxy grafana:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	log {
		output stdout
		format console
	}
}

# Leitstand – eigener Port, damit Grafana (8443) unverändert parallel läuft
https://192.168.0.172:8444 {
	tls internal
	reverse_proxy leitstand:8080
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'"
		-Server
	}
	log {
		output stdout
		format console
	}
}
