     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "ems-influx"
     },
     "query": "from(bucket: \"ems_detail\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"value\" and r.asset_id == \"vaillant_wp\" and r.quantity =~ /^active_power/)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, name: \"Leistung\" + (if r.quantity == \"active_power\" then \"\" else \" \" + r.quantity)}))\n  |> group(columns: [\"name\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"name\"])"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "watt",
     "decimals": 1,
     "displayName": "${__field.labels.name}",
