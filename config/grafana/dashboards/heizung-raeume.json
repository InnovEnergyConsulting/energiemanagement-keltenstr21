  {
   "type": "timeseries",
   "title": "Raumtemperaturen (Ist)",
   "gridPos": {
    "h": 10,
    "w": 24,
    "x": 0,
    "y": 19
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "ems-influx"
     },
     "query": "from(bucket: \"ems_detail\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"value\" and r.quantity == \"temperature\" and r.role == \"room_actual\")\n  |> group(columns: [\"name\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"name\"])"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "decimals": 1,
     "custom": {
      "lineWidth": 2,
      "spanNulls": 3600000,
      "showPoints": "never"
     },
     "displayName": "${__field.labels.name}"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "min",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "datasource": {
    "type": "influxdb",
    "uid": "ems-influx"
   },
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Ist und Soll – ${raum}",
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 29
   },
   "repeat": null,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "ems-influx"
     },
     "query": "from(bucket: \"ems_detail\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"value\" and r.name == \"${raum}\")\n  |> filter(fn: (r) => r.quantity == \"temperature\" or r.quantity == \"temperature_setpoint\")\n  |> map(fn: (r) => ({_time: r._time, _value: r._value, _field: if r.quantity == \"temperature\" then \"Ist\" else \"Soll\"}))\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "celsius",
     "decimals": 1,
     "custom": {
      "lineWidth": 2,
      "spanNulls": 3600000
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Soll"
      },
      "properties": [
       {
        "id": "custom.lineInterpolation",
        "value": "stepAfter"
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          10,
          10
         ]
        }
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Ist"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "blue"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "datasource": {
    "type": "influxdb",
    "uid": "ems-influx"
   },
   "id": 10
