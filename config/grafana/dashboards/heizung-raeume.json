     },
     "query": "from(bucket: \"ems_raw\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"raw\" and r.source == \"controme\" and r.stream == \"temps\" and r._field == \"http_status\")\n  |> last()\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: uint(v: now()) - uint(v: r._time)) / 60000000000.0}))"
