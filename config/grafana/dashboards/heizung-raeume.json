  {
   "type": "table",
   "title": "Räume – Ist, Soll, Datenalter",
   "description": "Datenalter = Minuten seit der letzten Übertragung des Raumsensors. Räume ohne Sensor (OG) zeigen bewusst keinen Ist-Wert statt 0.",
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "ems-influx"
     },
     "query": "import \"join\"\nbase = from(bucket: \"ems_detail\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and r._field == \"value\" and r.source == \"controme\" and r.medium == \"room_climate\")\n  |> last()\nvals = base\n  |> group()\n  |> keep(columns: [\"asset_id\", \"name\", \"floor\", \"quantity\", \"_value\"])\n  |> pivot(rowKey: [\"asset_id\", \"name\", \"floor\"], columnKey: [\"quantity\"], valueColumn: \"_value\")\nage = base\n  |> filter(fn: (r) => r.quantity == \"temperature\")\n  |> group()\n  |> map(fn: (r) => ({asset_id: r.asset_id, alter_min: float(v: uint(v: now()) - uint(v: r._time)) / 60000000000.0}))\njoin.left(left: vals, right: age, on: (l, r) => l.asset_id == r.asset_id, as: (l, r) => ({l with alter_min: r.alter_min}))\n  |> sort(columns: [\"floor\", \"name\"])\n"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "asset_id": true,
       "temperature_setpoint_permanent": true,
       "result": true,
       "table": true
      },
      "indexByName": {
       "floor": 0,
       "name": 1,
       "temperature": 2,
       "temperature_setpoint": 3,
       "temperature_offset": 4,
       "temperature_setpoint_next": 5,
       "relative_humidity": 6,
       "alter_min": 7
      },
      "renameByName": {
       "floor": "Etage",
       "name": "Raum",
       "temperature": "Ist",
       "temperature_setpoint": "Soll",
       "temperature_offset": "Offset",
       "relative_humidity": "Luftfeuchte",
       "temperature_setpoint_next": "Nächster Soll",
       "alter_min": "Datenalter"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "Ist|Soll|Nächster Soll"
      },
      "properties": [
       {
        "id": "unit",
        "value": "celsius"
       },
       {
        "id": "decimals",
        "value": 1
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Offset"
      },
      "properties": [
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "decimals",
        "value": 2
       },
       {
        "id": "displayName",
        "value": "Offset (K)"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Luftfeuchte"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Datenalter"
      },
      "properties": [
       {
        "id": "unit",
        "value": "m"
       },
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "basic"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 45
          },
          {
           "color": "red",
           "value": 120
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "datasource": {
    "type": "influxdb",
    "uid": "ems-influx"
   },
   "id": 7
  },
